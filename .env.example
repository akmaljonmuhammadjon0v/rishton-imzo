# Use long, unique values. Do not use the example values in production.
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Point this at a persistent writable volume in production.
# Defaults to ./data for local development.
DATA_DIR=./data

# Set this to the public production domain before deployment for canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.uz
